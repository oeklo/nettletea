FROM docker.io/library/node:26-slim AS builder
WORKDIR /app

RUN npm install -g --allow-scripts=pnpm pnpm@12

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json tsdown.config.ts ./
COPY src ./src

ENV NODE_ENV=production
RUN pnpm build
RUN pnpm prune --prod
RUN find dist -name '*.d.ts*' -delete
RUN rm -rf src pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsdown.config.ts

FROM docker.io/library/node:26-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app ./

USER node
EXPOSE 3000
ENTRYPOINT ["node", "--enable-source-maps", "dist/cli.js"]
